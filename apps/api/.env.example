NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://localhost:27017/ai-task-manager

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3000

# Leave empty to use the mock AI provider (deterministic, no network)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
