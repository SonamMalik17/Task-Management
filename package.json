{
  "name": "ai-task-manager",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted task management system. Monorepo: Next.js web + Express API + shared types.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @ai-task/api",
    "dev:web": "npm run dev -w @ai-task/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "SonamMalik17 <maliksonam0301@gmail.com>",
  "license": "MIT"
}
