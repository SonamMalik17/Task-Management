# Root .env.example — copy app-specific values into apps/api/.env and apps/web/.env.local

# === API ===
NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://localhost:27017/ai-task-manager
JWT_ACCESS_SECRET=change-me-32-chars-min-please-rotate
JWT_REFRESH_SECRET=change-me-32-chars-min-please-rotate-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000

# AI provider — leave empty to use deterministic mock provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# === WEB ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
